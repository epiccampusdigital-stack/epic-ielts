generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String
  name            String
  address         String?
  age             Int?
  city            String?
  phone           String?
  expectedBand    Float?
  batch           String?
  role              String         @default("STUDENT")
  isPaid            Boolean        @default(false)
  paidAt            DateTime?
  stripeSessionId   String?
  hasFullAccess     Boolean        @default(false)
  placementDone     Boolean        @default(false)
  placementBand     Float?
  attempts          Attempt[]
  feedbacks         Feedback[]
  studentLevels     StudentLevel[]
  learnProgress     LearnProgress[]
  emailVerified     Boolean        @default(false)
  verificationToken String?
}

model Paper {
  id              Int           @id @default(autoincrement())
  paperCode       String
  testType        String        // Keep as String to avoid data loss during migration
  title           String
  timeLimitMin    Int           @default(60)
  instructions    String?       @db.Text
  audioUrl        String?
  audioScript     String?       @db.Text
  status          String        @default("PUBLISHED") 
  assignedBatches String        @default("ALL")
  order           Int           @default(0)
  practiceMode    Boolean       @default(false)
  track           String        @default("IELTS") // IELTS | GENERAL
  questions       Question[]
  passages        Passage[]
  sections        Section[]
  writingTasks    WritingTask[]
  attempts        Attempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([paperCode, testType])
}

model Passage {
  id            Int     @id @default(autoincrement())
  paperId       Int
  paper         Paper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  passageNumber Int
  title         String?
  text          String  @db.Text
  groups        QuestionGroup[]
}

model WritingTask {
  id               Int                @id @default(autoincrement())
  paperId          Int
  paper            Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  taskNumber       Int                // 1 or 2
  prompt           String             @db.Text
  chartImageUrl    String?
  chartDescription String?            @db.Text
  minWords         Int                @default(150)
  timeMinutes      Int                @default(20)
  tableData        Json?
  submissions      WritingSubmission[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Section {
  id          Int             @id @default(autoincrement())
  paperId     Int
  paper       Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  number      Int             // 1, 2, 3, 4
  description String?         @db.Text
  audioUrl    String?
  order       Int     @default(0)
  groups      QuestionGroup[]
}

model QuestionGroup {
  id           Int        @id @default(autoincrement())
  sectionId    Int?       // Optional: link to section (Listening)
  section      Section?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passageId    Int?       // Optional: link to passage (Reading)
  passage      Passage?   @relation(fields: [passageId], references: [id], onDelete: Cascade)
  groupType    String     // FORM_COMPLETION, MAP_LABELING, etc.
  instruction  String?    @db.Text
  imageUrl     String?
  tableData    Json?
  wordLimit    String?
  order        Int    @default(0)
  questions    Question[]
}

model Question {
  id               Int            @id @default(autoincrement())
  paperId          Int
  paper            Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  groupId          Int?
  group            QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  passageNumber    Int?           // For reading (1, 2, 3)
  sectionNumber    Int?           // For listening (1, 2, 3, 4)
  questionNumber   Int
  questionType     String         // TFNG, MC, SA, etc.
  content          String         @db.Text
  options          Json?
  correctAnswer    String         @db.Text
  explanation      String?        @db.Text
  imageUrl         String?
  audioUrl         String?
  wordLimit        String?
  order            Int        @default(0)
  tableData        Json?
  groupInstruction String?        @db.Text
  answers          Answer[]
}

model Attempt {
  id                 Int                 @id @default(autoincrement())
  studentId          Int
  paperId            Int
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper              Paper               @relation(fields: [paperId], references: [id], onDelete: Cascade)
  startedAt          DateTime            @default(now())
  endedAt            DateTime?
  status             String              @default("IN_PROGRESS")
  isPlacement        Boolean             @default(false)
  answers            Answer[]
  writingSubmission  WritingSubmission?
  speakingSubmission SpeakingSubmission?
  result             Result?
}

model Answer {
  id            Int      @id @default(autoincrement())
  attemptId     Int
  questionId    Int
  studentAnswer String   @db.Text
  isCorrect     Boolean?
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model WritingSubmission {
  id              Int         @id @default(autoincrement())
  attemptId       Int         @unique
  attempt         Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  writingTaskId   Int?        // Link to specific task if needed
  writingTask     WritingTask? @relation(fields: [writingTaskId], references: [id])
  task1Response   String?     @db.Text
  task2Response   String?     @db.Text
  task1WordCount  Int?
  task2WordCount  Int?
  task1Band       Float?
  task2Band       Float?
  overallBand     Float?
  aiFeedback      String?     @db.Text
  markingStatus   String      @default("PENDING")
  modelAnswers    String?     @db.Text
}

model Result {
  id                 Int      @id @default(autoincrement())
  attemptId          Int      @unique
  attempt            Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  rawScore           Float?
  bandEstimate       Float?
  teacherReviewed    Boolean  @default(false)
  overrideBand       Float?
  strengths          String?  @db.Text
  weaknesses          String?  @db.Text
  improvementAdvice  String?  @db.Text
  aiFeedbackJson     String?  @db.Text
  aiFeedback         String?  @db.Text
  finalStudentReport String?  @db.Text
}

model SpeakingSubmission {
  id               Int      @id @default(autoincrement())
  attemptId        Int      @unique
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part1AudioUrl    String?
  part2AudioUrl    String?
  part3AudioUrl    String?
  part1Transcript  String?  @db.Text
  part2Transcript  String?  @db.Text
  part3Transcript  String?  @db.Text
  part1Band        Float?
  part2Band        Float?
  part3Band        Float?
  overallBand      Float?
  aiFeedback       String?  @db.Text
  markingStatus    String   @default("PENDING")
  createdAt        DateTime @default(now())
}

model StudentLevel {
  id              Int      @id @default(autoincrement())
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  levelNumber     Int
  purchasedAt     DateTime @default(now())
  stripeSessionId String?
  amountLKR       Int
}

model Level {
  id          Int            @id @default(autoincrement())
  levelNumber Int            @unique
  title       String
  description String?
  targetBand  String
  price       Float          @default(0)
  isActive    Boolean        @default(true)
  sections    LevelSection[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LevelSection {
  id            Int      @id @default(autoincrement())
  sectionNumber Int      @unique
  title         String
  levelId       Int
  level         Level    @relation(fields: [levelId], references: [id])
  readingCode   String?
  writingCode   String?
  listeningCode String?
  speakingCode  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Feedback {
  id        Int      @id @default(autoincrement())
  studentId Int
  subject   String?
  message   String
  type      String   @default("FEEDBACK")
  status    String   @default("OPEN")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id])
}

model LearnModule {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String
  color       String
  order       Int      @default(0)
  track       String   @default("IELTS") // IELTS | GENERAL
  createdAt   DateTime @default(now())
  lessons     LearnLesson[]
}

model LearnLesson {
  id           Int      @id @default(autoincrement())
  moduleId     Int
  module       LearnModule @relation(fields: [moduleId], references: [id])
  title        String
  content      String   @db.Text
  order        Int      @default(0)
  estimatedMin Int      @default(5)
  createdAt    DateTime @default(now())
  progress     LearnProgress[]
}

model LearnProgress {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  lessonId    Int
  lesson      LearnLesson @relation(fields: [lessonId], references: [id])
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

// ─── Residential programme tracker ──────────────────────────────────────────

model Program {
  id            Int                 @id @default(autoincrement())
  name          String
  startDate     String              // YYYY-MM-DD (Asia/Colombo)
  totalDays     Int                 @default(30)
  dayStartTime  String              @default("08:30")
  dayEndTime    String              @default("20:30")
  koreanSiteUrl String?
  adminPhone    String?
  remindMinutes Int                 @default(30)
  status        String              @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  days          ProgramDay[]
  sessions      ProgramSession[]
  students      ProgramStudent[]
  reminders     ProgramReminder[]
  changeLogs    ProgramChangeLog[]
}

model ProgramTeacher {
  id        Int               @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  subject   String            @default("ENGLISH") // ENGLISH | KOREAN | IT | OTHER
  focus     String?
  confirmed Boolean           @default(true)
  active    Boolean           @default(true)
  accountId Int?
  notes     String?           @db.Text
  createdAt DateTime          @default(now())
  sessions  ProgramSession[]
  reminders ProgramReminder[]
}

model ProgramDay {
  id           Int     @id @default(autoincrement())
  programId    Int
  program      Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber    Int
  date         String  // YYYY-MM-DD
  theme        String?
  englishFocus String? @db.Text
  koreanFocus  String? @db.Text
  itLabTask    String? @db.Text
  notes        String? @db.Text

  @@unique([programId, dayNumber])
}

model ProgramSession {
  id          Int                 @id @default(autoincrement())
  programId   Int
  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayNumber   Int
  startTime   String              // HH:MM
  endTime     String
  subject     String              // ENGLISH | KOREAN | IT_LAB | ACTIVITY | BREAK | ASSESSMENT | ADMIN
  language    String?             // EN | KR | null
  title       String
  description String?             @db.Text
  teacherId   Int?
  teacher     ProgramTeacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room        String?
  link        String?
  status      String              @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  notes       String?             @db.Text
  doneAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attendance  ProgramAttendance[]
  reminders   ProgramReminder[]

  @@index([programId, dayNumber])
}

model ProgramStudent {
  id          Int                 @id @default(autoincrement())
  programId   Int
  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  scholarship String?             // FULL | PARTIAL
  studentId   Int?
  notes       String?             @db.Text
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  attendance  ProgramAttendance[]
}

model ProgramAttendance {
  id               Int            @id @default(autoincrement())
  sessionId        Int
  session          ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programStudentId Int
  student          ProgramStudent @relation(fields: [programStudentId], references: [id], onDelete: Cascade)
  status           String         // PRESENT | LATE | ABSENT | EXCUSED
  updatedAt        DateTime       @updatedAt

  @@unique([sessionId, programStudentId])
}

model ProgramReminder {
  id        Int             @id @default(autoincrement())
  programId Int
  program   Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  teacherId Int?
  teacher   ProgramTeacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sessionId Int?
  session   ProgramSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String          // NIGHT_BEFORE | SESSION_SOON | DAILY_BRIEF | CHANGE | CUSTOM | ADMIN_DIGEST
  message   String          @db.Text
  dueAt     DateTime
  status    String          @default("PENDING") // PENDING | SENT | SKIPPED | FAILED
  channel   String?         // WHATSAPP_LINK | WHATSAPP_API
  sentAt    DateTime?
  error     String?         @db.Text
  dedupeKey String          @unique
  createdAt DateTime        @default(now())

  @@index([programId, status, dueAt])
}

model ProgramChangeLog {
  id        Int      @id @default(autoincrement())
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  summary   String   @db.Text
  actor     String?
  createdAt DateTime @default(now())
}
